#!/bin/sh
# Ordinary checks and critical browser paths run here, queued across worktrees.
# Race tests and the docs build are explicit: mise run check:full.
# Skip once with `git push --no-verify`.
set -e
# Git exports GIT_DIR and friends to hooks; tests that build fixture
# repositories would otherwise write into this one.
unset $(env | sed -n 's/^\(GIT_[A-Za-z_]*\)=.*/\1/p')
mise run check:push

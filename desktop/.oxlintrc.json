{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "rules": {
    "no-restricted-imports": ["error", {
      "paths": [{ "name": "electron", "message": "Pure modules never import electron: move Electron calls into main.ts, electron-*.ts, or preload.ts and pass plain functions in." }]
    }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    { "files": ["src/main/main.ts", "src/main/electron-*.ts", "src/preload/**", "test/smoke/**", "scripts/**"], "rules": { "no-restricted-imports": "off" } }
  ]
}

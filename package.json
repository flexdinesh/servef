{
  "name": "servef",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "pnpm --filter @servef/site build",
    "build:web": "pnpm --filter @servef/web build",
    "check": "mise run check:pr",
    "dev:site": "pnpm --filter @servef/site dev",
    "dev:web": "pnpm --filter @servef/web dev",
    "dev:mock": "pnpm --filter @servef/web dev:mock",
    "dev": "mise run dev",
    "link:local": "mise run install",
    "lint": "pnpm --filter @servef/web lint && pnpm --filter @servef/desktop lint",
    "test:browser": "mise run test:browser",
    "test:release": "node --test --test-concurrency=2 --test-reporter=dot tests/*.test.ts tests/browser/live-fixture.test.ts",
    "test:web": "pnpm --filter @servef/web test",
    "typecheck": "pnpm exec tsc --noEmit && pnpm --filter @servef/web typecheck && pnpm --filter @servef/site typecheck && pnpm --filter @servef/desktop typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.21",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.24.0"
}

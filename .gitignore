# Local binaries
/servef
/servef.exe
/bin/
/node_modules/
/apps/web/node_modules/
/apps/site/node_modules/
/apps/site/dist/
/playwright-report/
/test-results/
/.impeccable/review/

# Built frontend assets; never committed to any branch or tag (decision 0079)
/apps/servef/internal/web/dist/

# Go test and coverage output
/*.test
/coverage.out

# Local dev overrides (see .env.example)
/.env

# Source Control repository mise run dev rebuilds
/.dev/

# Sums go mod download records for the whole workspace graph; each module's
# go.sum stays authoritative.
/go.work.sum

# Desktop bundle (apps/desktop/build.ts)
/apps/desktop/node_modules/
/apps/desktop/build/
/apps/desktop/test-results/

# Desktop packages (apps/desktop/scripts/package.ts)
/apps/desktop/dist/
/apps/desktop/.build/

# Native app builds (apps/native, decision 0082): mygo build output and the
